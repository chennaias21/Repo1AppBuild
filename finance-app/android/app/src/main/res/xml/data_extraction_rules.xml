<?xml version="1.0" encoding="utf-8"?>
<!-- Rupee Routine keeps data on the device only: no Google cloud backup, no device-to-device transfer.
     Users move data themselves with the in-app Backup & Restore file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
