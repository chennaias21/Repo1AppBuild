# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, never NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard → Settings → API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Settings → Webhooks → create a webhook pointed at /api/payment/webhook, then copy its secret here.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Price in whole rupees, e.g. 299 for ₹299.
COURSE_PRICE_INR=299

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="SkillSopan <onboarding@resend.dev>"
# Public address of the site, used for links in emails.
NEXT_PUBLIC_SITE_URL=https://skillsopan.netlify.app

# --- Google Sheets (via the Apps Script in google-sheet-script/Code.gs) ---
# The Web App URL you get after deploying that script from your tracking Sheet.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Any long random text. Must match SHARED_SECRET at the top of Code.gs exactly.
SHEETS_WEBHOOK_SECRET=generate-a-random-string

# --- Reconciliation cron ---
# Any long random string; used as a bearer token to protect /api/cron/reconcile-sheets.
CRON_SECRET=generate-a-random-string
