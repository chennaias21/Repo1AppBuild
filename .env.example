# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, never NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard → Settings → API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Settings → Webhooks → create a webhook pointed at /api/payment/webhook, then copy its secret here.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Price in whole rupees, e.g. 999 for ₹999.
COURSE_PRICE_INR=999

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Excel Mastery <onboarding@resend.dev>"

# --- Google Sheets (Google Cloud service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=excel-mastery-sheets@your-project.iam.gserviceaccount.com
# Paste the full private key from the downloaded JSON, keeping the \n escape sequences as-is.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# --- Reconciliation cron ---
# Any long random string; used as a bearer token to protect /api/cron/reconcile-sheets.
CRON_SECRET=generate-a-random-string
